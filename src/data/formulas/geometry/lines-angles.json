    "id": "complementary-angles",
    "category": "Types",
    "title": "Complementary Angles",
    "formula": "∠A + ∠B = 90°",
    "latex": "\\angle A+\\angle B=90^\\circ",
    "description": "Two angles are complementary if their sum is 90 degrees.",
    "variables": [
      {
        "symbol": "∠A, ∠B",
        "meaning": "Complementary Angles"
      }
    ],
    "example": {
      "question": "One angle is 35°. Find its complement.",
      "solution": "90° − 35° = 55°."
    },
    "note": "Complementary angles together form a right angle."
