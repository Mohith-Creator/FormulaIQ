  {
    "id": "tan-angle-sum",
    "category": "Identity",
    "title": "Tangent Angle Sum Formula",
    "formula": "tan(A+B) = (tanA + tanB)/(1 - tanA tanB)",
    "latex": "\\tan(A+B)=\\frac{\\tan A+\\tan B}{1-\\tan A\\tan B}",
