[
  {
    "id": "pythagorean-identity",
    "category": "Identity",
    "title": "Pythagorean Identity",
    "formula": "sin²θ + cos²θ = 1",
    "latex": "\\sin^2\\theta+\\cos^2\\theta=1",
    "description": "Relates the squares of sine and cosine of the same angle.",
    "variables": [
      {
        "symbol": "θ",
        "meaning": "Angle"
      }
    ],
    "example": {
      "question": "If sin θ = 3/5, find cos θ.",
      "solution": "cos²θ = 1 − (3/5)² = 16/25 ⇒ cos θ = 4/5."
    },
    "note": "This is the most important trigonometric identity."
  },
  {
    "id": "sec-tan-identity",
    "category": "Identity",
    "title": "Secant-Tangent Identity",
    "formula": "sec²θ - tan²θ = 1",
    "latex": "\\sec^2\\theta-\\tan^2\\theta=1",
    "description": "Relates tangent and secant of the same angle.",
    "variables": [
      {
        "symbol": "θ",
        "meaning": "Angle"
      }
    ],
    "example": {
      "question": "If tan θ = 3/4, find sec θ.",
      "solution": "sec²θ = 1 + (3/4)² = 25/16 ⇒ sec θ = 5/4."
    },
    "note": "Derived from the Pythagorean identity."
  },
  {
    "id": "cosec-cot-identity",
    "category": "Identity",
    "title": "Cosecant-Cotangent Identity",
    "formula": "cosec²θ - cot²θ = 1",
    "latex": "\\cosec^2\\theta-\\cot^2\\theta=1",
    "description": "Relates cotangent and cosecant of the same angle.",
    "variables": [
      {
        "symbol": "θ",
        "meaning": "Angle"
      }
    ],
    "example": {
      "question": "If cot θ = 8/15, find cosec θ.",
      "solution": "cosec²θ = 1 + (8/15)² = 289/225 ⇒ cosec θ = 17/15."
    },
    "note": "Useful in simplifying trigonometric expressions."
  },
  {
    "id": "tan-ratio-identity",
    "category": "Identity",
    "title": "Tangent Identity",
    "formula": "tan θ = sin θ / cos θ",
    "latex": "\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta}",
    "description": "Expresses tangent in terms of sine and cosine.",
    "variables": [
      {
        "symbol": "θ",
        "meaning": "Angle"
      }
    ],
    "example": {
      "question": "If sin θ = 3/5 and cos θ = 4/5, find tan θ.",
      "solution": "tan θ = (3/5)/(4/5) = 3/4."
