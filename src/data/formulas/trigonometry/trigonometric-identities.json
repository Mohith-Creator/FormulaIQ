    "category": "Identity",
    "title": "Cotangent Identity",
    "formula": "cot θ = cos θ / sin θ",
    "latex": "\\cot\\theta=\\frac{\\cos\\theta}{\\sin\\theta}",
    "description": "Expresses cotangent in terms of cosine and sine.",
    "variables": [
      {
        "symbol": "θ",
        "meaning": "Angle"
      }
    ],
    "example": {
      "question": "If cos θ = 12/13 and sin θ = 5/13, find cot θ.",
      "solution": "cot θ = (12/13)/(5/13) = 12/5."
    },
    "note": "cot θ is the reciprocal of tan θ."
  },

  {
